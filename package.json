{
  "name": "tina-docker",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "TINA_PUBLIC_IS_LOCAL=true concurrently \"tinacms dev\" \"tsc --watch\" \"nodemon dist/app.js\" \"nodemon --watch site eleventy --input='site'\"",
    "dev:prod": "TINA_PUBLIC_IS_LOCAL=false concurrently \"tinacms dev\" \"tsc --watch\" \"nodemon dist/app.js\" \"nodemon --watch site eleventy --input='site'\"",
    "build": "tinacms build --partial-reindex --verbose && eleventy --input='site' && tsc",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@tinacms/cli": "^2.0.5",
    "@tinacms/datalayer": "^2.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "mongodb-level": "^0.0.3",
    "next": "14.2.35",
    "next-auth": "^4.24.13",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "serverless-http": "^3.2.0",
    "tinacms": "^2.10.1",
    "tinacms-authjs": "^2.0.7",
    "tinacms-gitprovider-github": "^2.0.19",
    "ts-node": "^10.9.2",
    "tsx": "^3.14.0",
    "wrangler": "^3.114.16"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vercel/node": "^3.2.29",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "nodemon": "^3.1.11",
    "typescript": "^5.9.3"
  }
}
