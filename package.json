{
  "name": "tina-docker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "TINA_PUBLIC_IS_LOCAL=true concurrently \"tinacms dev\" \"tsx watch app.ts\" \"eleventy --serve --input=site\"",
    "dev:prod": "TINA_PUBLIC_IS_LOCAL=false concurrently \"tinacms dev\" \"tsx watch app.ts\" \"eleventy --serve --input=site\"",
    "build": "tinacms build --partial-reindex --verbose && eleventy --input='site'",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@tinacms/cli": "^2.0.5",
    "@tinacms/datalayer": "^2.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "mongodb-level": "^0.0.4",
    "next": "16.1.0",
    "next-auth": "^4.24.13",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "serverless-http": "^4.0.0",
    "tinacms": "3.1.2",
    "tinacms-authjs": "^15.0.2",
    "tinacms-gitprovider-github": "^4.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "wrangler": "^4.56.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vercel/node": "^5.5.16",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "nodemon": "^3.1.11",
    "typescript": "^5.9.3"
  }
}
